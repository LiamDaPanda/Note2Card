# ---------------------------------------------------------------------------
# Note2Card configuration
#
# Copy to .env.local and fill in. Never commit .env.local.
# Every key here is read SERVER-SIDE ONLY — nothing is prefixed NEXT_PUBLIC_,
# so no credential is ever shipped to the browser.
# ---------------------------------------------------------------------------

# Required for real generation. Without it the app runs but shows a setup screen.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Provider selection, per pipeline stage -------------------------------
# "anthropic" | "openmodel" | "mock"
# `mock` needs no credentials and is what the test suite runs against.

# Reading handwriting from photos. Never downgrade this one — a misread term
# becomes a wrong flashcard a student then memorises.
AI_PROVIDER_EXTRACT=anthropic
ANTHROPIC_MODEL_EXTRACT=claude-opus-5

# Writing cards from already-clean text. Flip to `openmodel` once
# `npm run eval` shows quality holds.
AI_PROVIDER_GENERATE=anthropic
ANTHROPIC_MODEL_GENERATE=claude-sonnet-5

# Quality check. The deterministic pass in lib/checks.ts does most of this work,
# so the model here only handles what regexes can't.
AI_PROVIDER_CHECK=anthropic
ANTHROPIC_MODEL_CHECK=claude-haiku-4-5

# --- Optional: an OpenAI-compatible host for the cheap generation stage ----
OPENMODEL_BASE_URL=
OPENMODEL_API_KEY=
OPENMODEL_MODEL=

# --- Spend ceiling --------------------------------------------------------
# Hard monthly cap on free-tier spend, in USD. When crossed, free generation
# switches off until the month rolls over. This is what makes the worst case a
# number you chose rather than a number the internet chose for you.
MONTHLY_AI_BUDGET_USD=25

# Free-tier daily limits are product constants in lib/quota.ts (FREE_LIMITS),
# not env vars — they run in the browser too, where a server-only variable would
# read as undefined and silently disagree with the server.
